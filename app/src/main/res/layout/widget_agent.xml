<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_agent_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_agent"
            android:src="@drawable/ic_sparkle"
            android:tint="@color/accentStrong" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:text="@string/widget_agent"
            android:textColor="@color/txt"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/agent_ask"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/widget_ask"
            android:textColor="@color/txt"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/agent_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="@string/widget_no_agent"
        android:textColor="@color/txt2"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/agent_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/txt3"
        android:textSize="10.5sp" />
</LinearLayout>
