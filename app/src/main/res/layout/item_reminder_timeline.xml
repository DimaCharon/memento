<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/row_time"
        style="@style/T.Time"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="09:00" />

    <View
        android:layout_width="2dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:background="@color/stroke2" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_today"
            android:textColor="@color/txt"
            android:textSize="14.5sp" />

        <TextView
            android:id="@+id/row_place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="@color/txt3"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row_plus10"
                style="@style/MementoBtnGhost"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="36dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/plus10_short"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/row_edit"
                style="@style/MementoBtnGhost"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="36dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/edit_short"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/row_done"
                style="@style/MementoBtnGhost"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:minHeight="36dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="@string/done_short"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
