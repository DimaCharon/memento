# Переменные задаются в панели RelaxDev: проект → вкладка «Переменные».
# Файл нужен только как шпаргалка — секреты в репозиторий не коммитим.

# Необязательно: реальный Claude за пайплайном агентов.
# Без ключа приложение работает на встроенном локальном движке агентов.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Необязательно: если внешний API недоступен с серверов в России (Telegram и др.)
# Адрес берётся в панели: «Переменные» → «Webhook / Proxy» → «Получить адрес прокси».
OUTBOUND_PROXY_URL=

# Нужно только если пользуетесь коннектором «Telegram-бот» на веб-проекте:
TG_OPTION=1

# Порт платформа задаёт сама, вручную не нужно:
# PORT=8080
