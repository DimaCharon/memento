<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sheet_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_h"
            android:paddingTop="10dp"
            android:paddingEnd="@dimen/screen_h"
            android:paddingBottom="22dp">

            <View
                android:layout_width="44dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_pill" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheet_cancel"
                    style="@style/MementoBtnLink"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/cancel" />

                <TextView
                    android:id="@+id/sheet_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/new_reminder"
                    android:textColor="@color/txt"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sheet_save_top"
                    style="@style/MementoBtnLink"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="@string/ready" />
            </LinearLayout>

            <!-- Название -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/field_title"
                    android:src="@drawable/ic_bell"
                    android:tint="@color/txt3" />

                <EditText
                    android:id="@+id/sheet_input_title"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_title"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:textColor="@color/txt"
                    android:textColorHint="@color/txt3"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Дата -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/field_date"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/txt3" />

                <TextView
                    style="@style/T.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/field_date"
                    android:textColor="@color/txt" />

                <TextView
                    android:id="@+id/sheet_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 октября 2026"
                    android:textColor="@color/txt"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/field_date"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/txt3" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/sheet_chip_today"
                        style="@style/Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:minHeight="38dp"
                        android:text="@string/chip_today" />

                    <TextView
                        android:id="@+id/sheet_chip_tomorrow"
                        style="@style/Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:minHeight="38dp"
                        android:text="@string/chip_tomorrow" />

                    <TextView
                        android:id="@+id/sheet_chip_plus2"
                        style="@style/Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:minHeight="38dp"
                        android:text="@string/chip_plus2" />

                    <TextView
                        android:id="@+id/sheet_chip_week"
                        style="@style/Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:minHeight="38dp"
                        android:text="@string/chip_week" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Время -->
            <LinearLayout
                android:id="@+id/sheet_time_row"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/field_time"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/txt3" />

                <TextView
                    style="@style/T.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/field_time"
                    android:textColor="@color/txt" />

                <TextView
                    android:id="@+id/sheet_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00"
                    android:textColor="@color/txt"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/field_time"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/txt3" />
            </LinearLayout>

            <!-- Повтор -->
            <LinearLayout
                android:id="@+id/sheet_repeat_row"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/repeat"
                    android:src="@drawable/ic_refresh"
                    android:tint="@color/txt3" />

                <TextView
                    style="@style/T.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/repeat"
                    android:textColor="@color/txt" />

                <TextView
                    android:id="@+id/sheet_repeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/repeat_none"
                    android:textColor="@color/txt2"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/repeat"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/txt3" />
            </LinearLayout>

            <!-- Заметки -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="4dp"
                    android:contentDescription="@string/notes"
                    android:src="@drawable/ic_edit"
                    android:tint="@color/txt3" />

                <EditText
                    android:id="@+id/sheet_notes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/notes_hint"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:minLines="1"
                    android:textColor="@color/txt"
                    android:textColorHint="@color/txt3"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Место -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/place"
                    android:src="@drawable/ic_globe"
                    android:tint="@color/txt3" />

                <EditText
                    android:id="@+id/sheet_place"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/place_hint"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColor="@color/txt"
                    android:textColorHint="@color/txt3"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Уведомление -->
            <LinearLayout
                android:id="@+id/sheet_lead_row"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/lead"
                    android:src="@drawable/ic_alarm"
                    android:tint="@color/txt3" />

                <TextView
                    style="@style/T.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/lead"
                    android:textColor="@color/txt" />

                <TextView
                    android:id="@+id/sheet_lead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lead_10"
                    android:textColor="@color/txt2"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@string/lead"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/txt3" />
            </LinearLayout>

            <!-- Приоритет -->
            <TextView
                style="@style/T.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/priority" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/sheet_prio_high"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/sel_segment"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_high" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/prio_high"
                        android:textColor="@color/sel_chip_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sheet_prio_medium"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/sel_segment"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_medium" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/prio_medium"
                        android:textColor="@color/sel_chip_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sheet_prio_low"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/sel_segment"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_low" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/prio_low"
                        android:textColor="@color/sel_chip_text"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/sheet_save"
                style="@style/MementoBtnPrimary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:text="@string/save" />

            <TextView
                android:id="@+id/sheet_delete"
                style="@style/MementoBtnGhost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/delete"
                android:textColor="@color/err"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
