<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Экраны приложения -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Нижняя навигация: 4 вкладки, центральная кнопка «+» лежит поверх, ровно по центру -->
    <include
        android:id="@+id/nav_bar"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:layout_gravity="bottom" />

    <FrameLayout
        android:id="@+id/fab"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/fab_margin_bottom"
        android:background="@drawable/bg_fab"
        android:clickable="true"
        android:contentDescription="@string/nav_add"
        android:elevation="8dp"
        android:focusable="true"
        android:foreground="@drawable/ripple_fab">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/nav_add"
            android:src="@drawable/ic_plus"
            android:tint="@color/accentOn" />
    </FrameLayout>
</FrameLayout>
