<?xml version="1.0" encoding="utf-8"?>
<!-- Превью виджета «Сегодня»: так его видно в списке виджетов и первую секунду на столе -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_today"
            android:src="@drawable/ic_calendar"
            android:tint="@color/txt2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:text="@string/widget_today"
            android:textColor="@color/txt"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/three_events"
            android:textColor="@color/txt3"
            android:textSize="11sp" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_notif_icon"
            android:contentDescription="@string/nav_add"
            android:padding="5dp"
            android:src="@drawable/ic_plus"
            android:tint="@color/txt" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="7dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="09:30"
            android:textColor="@color/txt"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Встреча с командой"
            android:textColor="@color/txt"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/mark_done"
            android:src="@drawable/bg_check_off" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="7dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="12:00"
            android:textColor="@color/txt"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Позвонить клиенту"
            android:textColor="@color/txt"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/mark_done"
            android:src="@drawable/bg_check_off" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_widget_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="7dp">

        <TextView
            android:layout_width="42dp"
            android:layout_height="wrap_content"
            android:text="18:30"
            android:textColor="@color/txt"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Тренировка"
            android:textColor="@color/txt"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/mark_done"
            android:src="@drawable/bg_check_off" />
    </LinearLayout>
</LinearLayout>
