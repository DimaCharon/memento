<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_card"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Верхняя строка: когда и цветовой маркер приоритета -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_when"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/notif_in"
            android:textColor="@color/txt3"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/notif_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:contentDescription="@string/priority"
            android:src="@drawable/dot_high" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notif_icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_notif_icon"
            android:contentDescription="@string/app_name"
            android:padding="10dp"
            android:src="@drawable/ic_bell"
            android:tint="@color/txt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_today"
                android:textColor="@color/txt"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/notif_open"
                android:textColor="@color/txt2"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notif_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_snooze"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_btn"
            android:gravity="center"
            android:text="@string/snooze_10"
            android:textColor="@color/txt"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/notif_done"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_btn_light"
            android:gravity="center"
            android:text="@string/mark_done"
            android:textColor="@color/accentOn"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
