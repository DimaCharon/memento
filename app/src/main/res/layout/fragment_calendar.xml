<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/content_bottom_inset"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_h">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cal_prev"
                style="@style/IconButton"
                android:contentDescription="@string/yesterday"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/txt" />

            <TextView
                android:id="@+id/cal_title"
                style="@style/T.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/calendar" />

            <ImageView
                android:id="@+id/cal_next"
                style="@style/IconButton"
                android:contentDescription="@string/tomorrow"
                android:scaleX="-1"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/txt" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cal_week_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cal_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cal_filter_all"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="@string/filter_all" />

            <TextView
                android:id="@+id/cal_filter_active"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="@string/filter_active" />

            <TextView
                android:id="@+id/cal_filter_done"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/filter_done" />
        </LinearLayout>

        <TextView
            android:id="@+id/cal_day_label"
            style="@style/T.H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/today" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cal_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/cal_empty"
            style="@style/T.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_empty"
            android:gravity="center"
            android:padding="22dp"
            android:text="@string/day_empty"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
