<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/ic_clock"
            android:tint="@color/txt2" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:letterSpacing="0.1"
            android:text="@string/widget_next"
            android:textAllCaps="true"
            android:textColor="@color/txt2"
            android:textSize="10sp" />

        <ImageView
            android:id="@+id/next_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:contentDescription="@string/priority"
            android:src="@drawable/dot_medium" />
    </LinearLayout>

    <TextView
        android:id="@+id/next_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:text="09:00"
        android:textColor="@color/txt"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/next_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/nothing_today"
        android:textColor="@color/txt"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/next_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/txt3"
        android:textSize="11sp" />
</LinearLayout>
