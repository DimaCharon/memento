<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/content_bottom_inset"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_h">

        <TextView
            style="@style/T.H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/profile" />

        <!-- Карточка пользователя -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/pf_avatar"
                android:layout_width="@dimen/avatar"
                android:layout_height="@dimen/avatar"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:text="А"
                android:textColor="@color/txt"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pf_name"
                    style="@style/T.H2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/pf_series"
                    style="@style/T.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/series" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pf_chip_today"
                        style="@style/Chip.Square"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:minHeight="34dp"
                        android:text="@string/today" />

                    <TextView
                        android:id="@+id/pf_chip_all"
                        style="@style/Chip.Square"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:minHeight="34dp"
                        android:text="@string/widget_all" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Профили -->
        <TextView
            style="@style/T.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/profiles" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pf_profiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/pf_new_profile"
                style="@style/Field"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="@string/new_profile_hint"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLines="1" />

            <TextView
                android:id="@+id/pf_create_profile"
                style="@style/MementoBtnGhost"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:minHeight="48dp"
                android:text="@string/create" />
        </LinearLayout>

        <!-- Настройки -->
        <TextView
            style="@style/T.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/settings" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/T.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_name" />

            <EditText
                android:id="@+id/pf_user_name"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="@string/setting_name"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:maxLines="1" />

            <TextView
                style="@style/T.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setting_widget_size" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/pf_size_2x2"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/sel_segment"
                    android:gravity="center"
                    android:text="@string/size_2x2"
                    android:textColor="@color/sel_chip_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pf_size_4x2"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/sel_segment"
                    android:gravity="center"
                    android:text="@string/size_4x2"
                    android:textColor="@color/sel_chip_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pf_size_4x4"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/sel_segment"
                    android:gravity="center"
                    android:text="@string/size_4x4"
                    android:textColor="@color/sel_chip_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/T.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/setting_theme" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/pf_theme_graphite"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/sel_segment"
                    android:gravity="center"
                    android:text="@string/theme_graphite"
                    android:textColor="@color/sel_chip_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/pf_theme_coal"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/sel_segment"
                    android:gravity="center"
                    android:text="@string/theme_coal"
                    android:textColor="@color/sel_chip_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <include
                android:id="@+id/set_notifications"
                layout="@layout/view_setting_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <include
                android:id="@+id/set_sound"
                layout="@layout/view_setting_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/set_verification"
                layout="@layout/view_setting_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/set_background"
                layout="@layout/view_setting_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/set_offline"
                layout="@layout/view_setting_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/pf_reset"
                style="@style/MementoBtnGhost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="@string/reset_demo" />

            <TextView
                android:id="@+id/pf_about"
                style="@style/MementoBtnLink"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/about" />
        </LinearLayout>

        <!-- ИИ -->
        <TextView
            style="@style/T.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/ai_section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                style="@style/T.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ai_section_sub" />

            <TextView
                android:id="@+id/pf_ai_status"
                style="@style/T.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:text="@string/use_local" />

            <TextView
                style="@style/T.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/api_key" />

            <EditText
                android:id="@+id/pf_api_key"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:hint="@string/api_key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1" />

            <TextView
                style="@style/T.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/base_url" />

            <EditText
                android:id="@+id/pf_base_url"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1" />

            <TextView
                style="@style/T.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/model" />

            <EditText
                android:id="@+id/pf_model"
                style="@style/Field"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pf_check_key"
                    style="@style/MementoBtnGhost"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/check_key" />

                <TextView
                    android:id="@+id/pf_save_ai"
                    style="@style/MementoBtnPrimary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/save" />
            </LinearLayout>
        </LinearLayout>

        <!-- Разрешения -->
        <TextView
            style="@style/T.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/permissions_section" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp">

            <include
                android:id="@+id/perm_notifications"
                layout="@layout/view_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/perm_mic"
                layout="@layout/view_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/perm_exact"
                layout="@layout/view_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/perm_battery"
                layout="@layout/view_permission_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/pf_test_notification"
                style="@style/MementoBtnGhost"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/test_notification" />
        </LinearLayout>

        <TextView
            android:id="@+id/pf_version"
            style="@style/T.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/app_name" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
