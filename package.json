{
  "name": "memento",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Memento — веб-приложение напоминаний с виджетами и ИИ-агентами",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --force",
    "test:nlu": "node scripts/nlu-test.mjs",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^6.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=18.17"
  }
}
