<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/content_bottom_inset"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/screen_h"
        android:paddingBottom="@dimen/s4">

        <!-- Строка состояния: день и время -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_day"
                style="@style/T.Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/today" />

            <TextView
                android:id="@+id/home_clock"
                style="@style/T.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19:23" />
        </LinearLayout>

        <!-- Приветствие + кольцо прогресса -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/home_greeting"
                    style="@style/T.H1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/home_sub"
                    style="@style/T.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/no_reminders_hint" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="@dimen/ring_lg"
                android:layout_height="@dimen/ring_lg"
                android:layout_marginStart="12dp">

                <ru.memento.ui.view.RingView
                    android:id="@+id/home_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/home_ring_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="0/0"
                    android:textColor="@color/txt"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <!-- Ассистент: голосовая команда -->
        <LinearLayout
            android:id="@+id/home_assistant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="@dimen/icon_box"
                android:layout_height="@dimen/icon_box"
                android:background="@drawable/bg_icon_box"
                android:contentDescription="@string/assistant"
                android:padding="9dp"
                android:src="@drawable/ic_mic"
                android:tint="@color/accentStrong" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/T.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/assistant" />

                <TextView
                    android:id="@+id/home_assistant_sub"
                    style="@style/T.Small"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/assistant_sub" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/open"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/txt3" />
        </LinearLayout>

        <!-- Виджет «Сегодня» -->
        <LinearLayout
            android:id="@+id/home_card_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_widget"
            android:orientation="vertical"
            android:padding="@dimen/card_pad">

            <LinearLayout
                android:id="@+id/home_today_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/widget_today"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/txt2" />

                <TextView
                    style="@style/T.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/widget_today" />

                <TextView
                    android:id="@+id/home_today_count"
                    style="@style/T.Small"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/no_reminders" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/to_home"
                    android:src="@drawable/ic_chevron_right"
                    android:tint="@color/txt3" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_today_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/home_today_empty"
                style="@style/T.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="6dp"
                android:gravity="center"
                android:text="@string/nothing_today"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Виджет «Следующее» -->
        <LinearLayout
            android:id="@+id/home_card_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_widget"
            android:orientation="vertical"
            android:padding="@dimen/card_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/widget_next"
                    android:src="@drawable/ic_clock"
                    android:tint="@color/txt2" />

                <TextView
                    style="@style/T.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/widget_next" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_next_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/no_reminders"
                android:textColor="@color/txt"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_next_sub"
                style="@style/T.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/next_none" />

            <TextView
                android:id="@+id/home_next_chip"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/today"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Виджет «Прогресс дня» -->
        <LinearLayout
            android:id="@+id/home_card_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_widget"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/card_pad">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@string/widget_progress"
                        android:src="@drawable/ic_target"
                        android:tint="@color/txt2" />

                    <TextView
                        style="@style/T.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/widget_progress" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/home_progress_done"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="0"
                        android:textColor="@color/txt"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/home_progress_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="/ 0"
                        android:textColor="@color/txt3"
                        android:textSize="15sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/home_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_ai_progress" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="@dimen/ring_sm"
                android:layout_height="@dimen/ring_sm"
                android:layout_marginStart="12dp">

                <ru.memento.ui.view.RingView
                    android:id="@+id/home_progress_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:ringStroke="5dp" />

                <TextView
                    android:id="@+id/home_progress_percent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="0%"
                    android:textColor="@color/txt2"
                    android:textSize="12sp" />
            </FrameLayout>
        </LinearLayout>

        <!-- Виджет «Ближайшая неделя» -->
        <LinearLayout
            android:id="@+id/home_card_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_widget"
            android:orientation="vertical"
            android:padding="@dimen/card_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/widget_week"
                    android:src="@drawable/ic_week"
                    android:tint="@color/txt2" />

                <TextView
                    style="@style/T.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/widget_week" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/home_week_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Виджет «Расписание на день» (таймлайн 4×4) -->
        <LinearLayout
            android:id="@+id/home_card_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_widget"
            android:orientation="vertical"
            android:padding="@dimen/card_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/widget_day"
                    android:src="@drawable/ic_list"
                    android:tint="@color/txt2" />

                <TextView
                    style="@style/T.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/widget_day" />

                <TextView
                    android:id="@+id/home_day_total"
                    style="@style/T.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_day_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>

        <!-- Виджет «Агент» -->
        <LinearLayout
            android:id="@+id/home_card_agent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_widget"
            android:orientation="vertical"
            android:padding="@dimen/card_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/widget_agent"
                    android:src="@drawable/ic_sparkle"
                    android:tint="@color/accentStrong" />

                <TextView
                    style="@style/T.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/widget_agent" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_agent_text"
                style="@style/T.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/assistant_sub" />

            <TextView
                android:id="@+id/home_agent_btn"
                style="@style/Btn.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/nav_ai" />
        </LinearLayout>

        <TextView
            android:id="@+id/home_widgets_link"
            style="@style/Btn.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/all_widgets" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
