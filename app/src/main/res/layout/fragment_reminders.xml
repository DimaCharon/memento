<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/content_bottom_inset"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_h"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_h">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/T.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reminders" />

            <TextView
                android:id="@+id/rem_counter"
                style="@style/T.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_count"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="0"
                android:textColor="@color/accentStrong" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_segment"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/rem_tab_active"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/sel_segment"
                android:gravity="center"
                android:selected="true"
                android:text="@string/filter_active"
                android:textColor="@color/sel_chip_text"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/rem_tab_history"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/sel_segment"
                android:gravity="center"
                android:text="@string/notif_center"
                android:textColor="@color/sel_chip_text"
                android:textSize="13.5sp" />
        </LinearLayout>

        <!-- Фильтры активных напоминаний -->
        <LinearLayout
            android:id="@+id/rem_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rem_filter_all"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:selected="true"
                android:text="@string/filter_all" />

            <TextView
                android:id="@+id/rem_filter_overdue"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="@string/overdue" />

            <TextView
                android:id="@+id/rem_filter_done"
                style="@style/Chip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/filter_done" />
        </LinearLayout>

        <!-- Заголовок истории уведомлений -->
        <LinearLayout
            android:id="@+id/hist_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                style="@style/T.Small"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notif_empty" />

            <TextView
                android:id="@+id/hist_read"
                style="@style/Btn.Link"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:text="@string/mark_read" />

            <TextView
                android:id="@+id/hist_clear"
                style="@style/Btn.Link"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="36dp"
                android:text="@string/clear" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rem_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/rem_empty"
            style="@style/T.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_empty"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/no_reminders"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
