<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_h"
    android:paddingEnd="@dimen/screen_h"
    android:paddingTop="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ai_back"
            style="@style/IconButton"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_arrow_left"
            android:tint="@color/txt" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/T.H2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/assistant" />

            <TextView
                android:id="@+id/ai_model"
                style="@style/T.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/use_local" />
        </LinearLayout>

        <TextView
            android:id="@+id/ai_logs_toggle"
            style="@style/MementoBtnLink"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/agent_log" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ai_chat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="8dp"
        android:scrollbars="none" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ai_logs"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:padding="10dp"
        android:scrollbars="none"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/ai_examples_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ai_examples"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/ai_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/tap_and_speak"
        android:textColor="@color/txt2"
        android:textSize="13sp" />

    <FrameLayout
        android:id="@+id/ai_mic"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_mic_idle"
        android:clickable="true"
        android:focusable="true"
        android:foreground="@drawable/ripple_mic">

        <ImageView
            android:id="@+id/ai_mic_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:contentDescription="@string/tap_and_speak"
            android:src="@drawable/ic_mic"
            android:tint="@color/txt" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/ai_input"
            style="@style/Field"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="@string/type_command"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <FrameLayout
            android:id="@+id/ai_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_light"
            android:clickable="true"
            android:focusable="true"
            android:foreground="@drawable/bg_ripple_round">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/send"
                android:src="@drawable/ic_send"
                android:tint="@color/accentOn" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
